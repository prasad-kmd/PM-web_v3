# Copy to .env.local; never commit your actual secrets.
# Canonical site origin. REQUIRED for production builds: your public HTTPS origin.
# Local development only; replace this localhost value before building for production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Progressive Web App registration. Registration is production-only by
# default. Set to off before a production build to disable new service
# worker registrations and unregister existing PM workers/caches on visit.
# If a faulty worker is already controlling visitors, ship the documented
# self-unregistering /sw.js replacement as an emergency rollback.
NEXT_PUBLIC_PWA=on

# Read-only Notion CMS: share each database/data source with the integration.
NOTION_API_KEY=
# Token alternatives: NOTION_AUTH_TOKEN= or NOTION_API_TOKEN=
NOTION_PROJECTS_ID=
NOTION_BLOG_ID=
NOTION_ARTICLES_ID=
NOTION_TUTORIALS_ID=
NOTION_GLOSSARY_ID=
# Optional: NOTION_WIKI_ID=  (legacy glossary alias)
NOTION_NEWS_ID=
# Optional: NOTION_PROJECTS_DATABASE_ID= (projects alias)
NOTION_AUTHORS_ID=
NOTION_PUBLISHED_STATUS=Published
NOTION_API_VERSION=2026-03-11

# Contact & Workspace Notifications — Telegram values and Turnstile secret stay server-side.
# Supports a standard 1-on-1 bot chat OR a Telegram Supergroup with Topics enabled.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Optional integer `message_thread_id` values when TELEGRAM_CHAT_ID is a Forum group with Topics:
# Copy any message link inside a topic (https://t.me/c/<group>/<topic_id>) -> trailing number is <topic_id>.
# Leave unset (or 1) to post into the main chat / General topic.
# TELEGRAM_TOPIC_CONTACT=
# TELEGRAM_TOPIC_COMMENTS=
# TELEGRAM_TOPIC_AUTH=
# TELEGRAM_TOPIC_SYSTEM=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Server-only. The address the contact page reveals after a Turnstile check.
# It is never rendered into HTML or client bundles. Defaults to the site owner.
CONTACT_EMAIL=

# Open Graph image design: "editorial" (default) or "window".
OG_STYLE=editorial

# Set to 1 to expose /dev/states (state previews) in production builds.
ENABLE_DEV_ROUTES=

# Comments — guest comments stored as native Notion comments on the page.
# The Notion integration needs "Read comments" and "Insert comments" on each
# page that should accept them; Turnstile (above) is reused for this form.
# COMMENTS_ENABLED=true
# COMMENTS_STORE_EMAIL=true
# COMMENTS_RATE_LIMIT=3
# COMMENTS_RATE_WINDOW_MS=60000
# COMMENTS_DAILY_LIMIT=12
# COMMENTS_AVATAR_TIMEOUT_MS=3000
# Optional: set to true to also send a Telegram notification when you reply as owner:
# COMMENTS_NOTIFY_OWNER_POSTS=false
# Optional comma-separated comment IDs to hide from public view even without Firebase:
# COMMENTS_HIDDEN_IDS=

# Readership Counter & Owner Content Insights Studio (`/insights`) — Server-only Firebase RTDB
# See docs/engagement-and-insights.md for database rules (`.read: false, .write: false`) and key setup.
FIREBASE_DATABASE_URL=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Owner Workstation Suite (Admin Sign-In, OG Image Studio & Invoice Studio)
# Generate hashes via: node scripts/hash-admin-password.mjs "<your-password>"
# Uses colon format (`scrypt:<saltHex>:<derivedHex>`) so Next.js .env never expands `$` vars.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Optional local-dev convenience fallback if ADMIN_PASSWORD_HASH is unset:
# ADMIN_PASSWORD=
# Required >=32-char secret signing the stateless HttpOnly session cookie:
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_HOURS=12
# Optional Two-Step Verification (TOTP + 30-day trusted workstation + recovery codes)
# Generate QR & recovery hashes via: node scripts/generate-admin-totp.mjs
# ADMIN_TOTP_SECRET=
# ADMIN_TRUST_TTL_DAYS=30
# ADMIN_RECOVERY_HASHES=
# Optional Owner Comment Profile overrides (auto-filled with Owner badge when signed in;
# defaults to INVOICE_BUSINESS_NAME / CONTACT_EMAIL / prasad-kmd):
# ADMIN_DISPLAY_NAME=Prasad Madhuranga
# ADMIN_COMMENT_EMAIL=
# ADMIN_GITHUB_HANDLE=prasad-kmd
# ADMIN_LINKEDIN_HANDLE=prasad-madhuranga
# ADMIN_TWITTER_HANDLE=prasadmadhuran1
# ADMIN_AVATAR_URL=/images/profile-placeholder.jpg

# Invoice Studio Notion storage (uses NOTION_INVOICES_TOKEN if set, else NOTION_API_KEY)
# NOTION_INVOICES_TOKEN=
NOTION_INVOICES_ID=
# Optional separate Clients database (falls back to NOTION_INVOICES_ID with Kind="Client"):
NOTION_CLIENTS_ID=
# Optional Notion page storing JSON business settings (falls back to INVOICE_* env vars):
NOTION_INVOICE_SETTINGS_PAGE_ID=

# Default Invoice Business Profile (used when NOTION_INVOICE_SETTINGS_PAGE_ID is unset)
INVOICE_BUSINESS_NAME=Prasad Madhuranga
INVOICE_BUSINESS_TAGLINE=Mechanical & Mechatronics Engineering
INVOICE_BUSINESS_EMAIL=contact@pmengineer.lk
INVOICE_BUSINESS_PHONE=
INVOICE_BUSINESS_WEBSITE=https://pmengineer.lk
INVOICE_BUSINESS_ADDRESS=Kandy, Central Province, Sri Lanka
INVOICE_BUSINESS_LOGO=/favicon-pm.svg
INVOICE_PREFIX=INV-
INVOICE_PADDING=4
INVOICE_DEFAULT_CURRENCY=LKR
INVOICE_DEFAULT_TAX_RATE=0

