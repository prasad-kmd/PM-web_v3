# Copy to .env.local; never commit your actual secrets.
# Canonical site origin. REQUIRED for production builds: your public HTTPS origin.
# Local development only; replace this localhost value before building for production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Read-only Notion CMS: share each database/data source with the integration.
NOTION_API_KEY=
# Token alternatives: NOTION_AUTH_TOKEN= or NOTION_API_TOKEN=
NOTION_PROJECTS_ID=
NOTION_BLOG_ID=
NOTION_ARTICLES_ID=
NOTION_TUTORIALS_ID=
NOTION_GLOSSARY_ID=
# Optional: NOTION_WIKI_ID=  (legacy glossary alias)
NOTION_NEWS_ID=
# Optional: NOTION_PROJECTS_DATABASE_ID= (projects alias)
NOTION_AUTHORS_ID=
NOTION_PUBLISHED_STATUS=Published
NOTION_API_VERSION=2026-03-11

# Contact form — Telegram values and Turnstile secret stay server-side.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Server-only. The address the contact page reveals after a Turnstile check.
# It is never rendered into HTML or client bundles. Defaults to the site owner.
CONTACT_EMAIL=

# Open Graph image design: "editorial" (default) or "window".
OG_STYLE=editorial

# Set to 1 to expose /dev/states (state previews) in production builds.
ENABLE_DEV_ROUTES=

# Comments — guest comments stored as native Notion comments on the page.
# The Notion integration needs "Read comments" and "Insert comments" on each
# page that should accept them; Turnstile (above) is reused for this form.
# COMMENTS_ENABLED=true
# COMMENTS_STORE_EMAIL=true
# COMMENTS_RATE_LIMIT=3
# COMMENTS_RATE_WINDOW_MS=60000
# COMMENTS_DAILY_LIMIT=12
# COMMENTS_AVATAR_TIMEOUT_MS=3000

# Owner Workstation Suite (Admin Sign-In, OG Image Studio & Invoice Studio)
# Generate hashes via: node scripts/hash-admin-password.mjs "<your-password>"
# Uses colon format (`scrypt:<saltHex>:<derivedHex>`) so Next.js .env never expands `$` vars.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Optional local-dev convenience fallback if ADMIN_PASSWORD_HASH is unset:
# ADMIN_PASSWORD=
# Required >=32-char secret signing the stateless HttpOnly session cookie:
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_HOURS=12
# Optional Base32 RFC 6238 TOTP secret for 2-step unlock:
# ADMIN_TOTP_SECRET=

# Invoice Studio Notion storage (uses NOTION_INVOICES_TOKEN if set, else NOTION_API_KEY)
# NOTION_INVOICES_TOKEN=
NOTION_INVOICES_ID=
# Optional separate Clients database (falls back to NOTION_INVOICES_ID with Kind="Client"):
NOTION_CLIENTS_ID=
# Optional Notion page storing JSON business settings (falls back to INVOICE_* env vars):
NOTION_INVOICE_SETTINGS_PAGE_ID=

# Default Invoice Business Profile (used when NOTION_INVOICE_SETTINGS_PAGE_ID is unset)
INVOICE_BUSINESS_NAME=Prasad Madhuranga
INVOICE_BUSINESS_TAGLINE=Mechanical & Mechatronics Engineering
INVOICE_BUSINESS_EMAIL=contact@pmengineer.lk
INVOICE_BUSINESS_PHONE=
INVOICE_BUSINESS_WEBSITE=https://pmengineer.lk
INVOICE_BUSINESS_ADDRESS=Kandy, Central Province, Sri Lanka
INVOICE_BUSINESS_LOGO=/favicon-pm.svg
INVOICE_PREFIX=INV-
INVOICE_PADDING=4
INVOICE_DEFAULT_CURRENCY=LKR
INVOICE_DEFAULT_TAX_RATE=0

