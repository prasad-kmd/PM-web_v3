# Projects-only, read-only Notion CMS (server-side only)
NOTION_API_KEY=
# Alternative token names accepted by the server:
# NOTION_AUTH_TOKEN=
# NOTION_API_TOKEN=
NOTION_PROJECTS_ID=
# Optional; defaults to the current v2-compatible Notion API version.
NOTION_API_VERSION=2026-03-11
# Alternative database-ID variable:
# NOTION_PROJECTS_DATABASE_ID=
